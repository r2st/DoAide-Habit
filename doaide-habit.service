[Unit]
Description=DoAide Habit - Free Habit Tracker
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/doaide-habit
ExecStart=/usr/bin/npx serve -s dist -l tcp://172.18.0.1:3064
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
